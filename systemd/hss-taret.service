[Unit]
Description=HSS taret koprusu (TCP 5005 + konsol 8090)
After=network.target

[Service]
Type=simple
User=pi
# Host tarafinda kosar: ESP32 ve LiDAR host USB portlarina bagli.
ExecStart=/usr/bin/python3 -u /home/pi/hss_workspace/scripts/taret_sunucu.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
